{
  "hosting": {
    "site": "calc-margenes-ve-2026",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      ".github/**",
      "**/.github/**",
      ".gitignore",
      "firestore.rules",
      "package.json",
      "package-lock.json",
      "README.md",
      "tests/**",
      "calculadora-margenes-ve-solo-archivo.html",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/webhook/pabilo",
        "function": {
          "functionId": "pabiloWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/gracias",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}

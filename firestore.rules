rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {userId} (matches Firebase Auth UID)
// Fields:
//   - User profile metadata (up to 15 keys; owner-scoped writes, owner or admin read, admin list)
//
// Subcollection: users/{userId}/products
// Document ID: {productId}
// Required Fields:
//   - v: int (schema version)
//   - id: string (1..120 chars)
//   - name: string (1..120 chars)
//   - costUsd: number (> 0)
//   - marginPercent: number (>= 0 and < 100)
//   - fixedExpenseBs: number (>= 0)
//   - commissionPlatform: number (>= 0 and < 1)
//   - commissionPaymentMethod: number (>= 0 and < 1)
//   - commissionOther: number (>= 0 and < 1)
//   - roundStep: int (in [0, 1, 10, 50, 100])
//   - rateSourceName: string (in ['bcvUsd', 'binanceUsdt', 'euroBcv', 'custom'])
//   - createdAt: string (1..60 chars, ISO-8601 timestamp string)
//   - updatedAt: string (1..60 chars, ISO-8601 timestamp string)
// Optional Fields:
//   - category: string (0..80 chars) or null
//   - marginMode: string (in ['onCost', 'onSale']) or null
//   - customRateValue: number (>= 0) or null
//
// Subcollection: users/{userId}/history
// Document ID: {historyId}
// Required Fields:
//   - v: int (schema version)
//   - id: string (1..120 chars)
//   - title: string (1..160 chars)
//   - costUsd: number (> 0)
//   - marginPercent: number (>= 0 and < 100)
//   - fixedExpenseBs: number (>= 0)
//   - commissionPlatform: number (>= 0 and < 1)
//   - commissionPaymentMethod: number (>= 0 and < 1)
//   - commissionOther: number (>= 0 and < 1)
//   - roundStep: int (in [0, 1, 10, 50, 100])
//   - rateSourceName: string (in ['bcvUsd', 'binanceUsdt', 'euroBcv', 'custom'])
//   - rateValue: number (> 0)
//   - finalPriceBs: number (> 0)
//   - timestamp: string (1..60 chars, ISO-8601 timestamp string)
// Optional Fields:
//   - marginMode: string (in ['onCost', 'onSale']) or null
//   - precioExactoBs: number (>= 0) or null
//   - gananciaBs: number or null
//
// Subcollection: users/{userId}/subscription
// Document ID: 'current' (ACTIVE subscription; read-only for the owner,
//   written only by an admin [custom claim or verified admin email], Admin SDK, or the Firebase Console)
// Required Fields:
//   - v: int
//   - plan: string (in ['monthly', 'quarterly', 'semiannual', 'annual'])
//   - status: string (in ['active', 'expired', 'canceled'])
//   - startDate: string (10..60 chars, ISO-8601)
//   - endDate: string (10..60 chars, ISO-8601)
//   - provider: string (1..30 chars, e.g. 'manual', 'pabilo_bdv', 'pabilo_binance', 'admin_panel', 'admin_owner')
// Optional Fields:
//   - paymentRef: string (<= 100), orderId: string (<= 80), amountUsd: number (>= 0),
//     paidAmount: number (>= 0), currency: string (in ['BS', 'USD']),
//     overpaidAlert: bool, durationDays: int (0..3650), note: string (<= 200),
//     activatedBy: string (<= 120), updatedAt: string (<= 60)
// Document ID: 'pending' (payment reference submitted by the owner, awaiting
//   admin verification; owner may create/update/delete, admin may read/list/manage/delete)
// Required Fields:
//   - v: int
//   - plan: string (in ['monthly', 'quarterly', 'semiannual', 'annual'])
//   - method: string (in ['pago_movil', 'usdt'])
//   - reference: string (4..60 chars)
//   - amountUsd: number (> 0 and <= 100)
//   - status: string (must equal 'pending')
//   - provider: string (must equal 'manual')
//   - requestedAt: string (10..60 chars, ISO-8601)
// Optional Fields:
//   - amountBs: number (>= 0), rateBs: number (>= 0)
//
// Subcollection: users/{userId}/settings (owner-only)
// Document ID: 'profile'
//   - v: int, businessName: string (0..60), updatedAt: string (10..60)
// Document ID: 'alerts'
//   - v: int, gapEnabled: bool, gapThresholdPct: number (0..1000),
//     rateEnabled: bool, updatedAt: string (10..60)
//   - Optional (number or null, >= 0): bcvAboveBs, lastSeenBcvUsd
//   - Optional (string or null, <= 20): lastSeenBcvDate
//
// Collection: proOrders
// Document ID: {orderId} (e.g. 'pro_...')
//   Server-managed Pabilo checkout orders written strictly by Firebase Admin SDK
//   in Cloud Functions (`functions/pro-payments.js`). Non-anonymous owners may
//   read/query only their own orders (`resource.data.uid == request.auth.uid`);
//   all client writes are denied.
// Fields:
//   - v: int, id: string, uid: string, email: string, plan: string,
//     planName: string, durationDays: int, method: string, currency: string,
//     expectedAmountUsd: number, expectedAmountBs: number, expectedTotal: number,
//     paidAmount: number, remainingAmount: number, partials: list,
//     partialRefs: list, rateBs: number, rateSource: string,
//     rateEffectiveDate: string or null, status: string, attempts: int,
//     maxAttempts: int, autoVerify: bool, lastAttemptedReference: string or null,
//     providerErrorAt: string or null, retriableRefs: list,
//     payment: map or null, paidAt: string (optional), expiresAt: string,
//     createdAt: string, updatedAt: string
//
// Collection: paymentRefs
// Document ID: {refId} (e.g. 'pm_<digits>' or 'bp_<ref>')
//   Server-only transactional double-spend lock (Admin SDK only).
//   All client reads and writes are denied.
//
// Collection: rateLimits
// Document ID: {docId} (e.g. '<name>__<key>__<bucket>')
//   Server-only rate limiter buckets (Admin SDK only).
//   All client reads and writes are denied.
//
// Collection: config
// Document ID: {docId} (e.g. 'proPayments', 'pabiloPrivate')
//   Server-only payment config & private Pabilo bank IDs (Admin SDK only;
//   safe public fields are exposed via Cloud Function `getProPaymentConfig`).
//   All client reads and writes are denied.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isAuthenticated() &&
        (!('firebase' in request.auth.token) ||
         request.auth.token.firebase.get('sign_in_provider', '') != 'anonymous');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidOptionalNonNegativeNumber(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= 0);
    }

    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is number;
    }

    function isValidOptionalMarginMode(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field] in ['onCost', 'onSale']);
    }

    function isValidCommission(value) {
      return value is number && value >= 0 && value < 1;
    }

    function isValidRoundStep(value) {
      return value is int && value in [0, 1, 10, 50, 100];
    }

    function isValidRateSourceName(value) {
      return value is string &&
        value in ['bcvUsd', 'binanceUsdt', 'euroBcv', 'custom'];
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidUserProfile(data) {
      return data.keys().size() <= 15 &&
        (!('uid' in data) || data.uid == request.auth.uid);
    }

    function isValidProduct(data) {
      let requiredFields = [
        'v',
        'id',
        'name',
        'costUsd',
        'marginPercent',
        'fixedExpenseBs',
        'commissionPlatform',
        'commissionPaymentMethod',
        'commissionOther',
        'roundStep',
        'rateSourceName',
        'createdAt',
        'updatedAt'
      ];
      let allowedFields = [
        'v',
        'id',
        'name',
        'category',
        'costUsd',
        'marginPercent',
        'fixedExpenseBs',
        'commissionPlatform',
        'commissionPaymentMethod',
        'commissionOther',
        'roundStep',
        'rateSourceName',
        'marginMode',
        'customRateValue',
        'createdAt',
        'updatedAt'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        data.v is int &&
        validStringLength('id', 1, 120) &&
        validStringLength('name', 1, 120) &&
        isValidOptionalString('category', 0, 80) &&
        data.costUsd is number && data.costUsd > 0 &&
        data.marginPercent is number && data.marginPercent >= 0 && data.marginPercent < 100 &&
        data.fixedExpenseBs is number && data.fixedExpenseBs >= 0 &&
        isValidCommission(data.commissionPlatform) &&
        isValidCommission(data.commissionPaymentMethod) &&
        isValidCommission(data.commissionOther) &&
        isValidRoundStep(data.roundStep) &&
        isValidRateSourceName(data.rateSourceName) &&
        isValidOptionalMarginMode('marginMode') &&
        isValidOptionalNonNegativeNumber('customRateValue') &&
        validStringLength('createdAt', 1, 60) &&
        validStringLength('updatedAt', 1, 60);
    }

    function isValidHistoryEntry(data) {
      let requiredFields = [
        'v',
        'id',
        'title',
        'costUsd',
        'marginPercent',
        'fixedExpenseBs',
        'commissionPlatform',
        'commissionPaymentMethod',
        'commissionOther',
        'roundStep',
        'rateSourceName',
        'rateValue',
        'finalPriceBs',
        'timestamp'
      ];
      let allowedFields = [
        'v',
        'id',
        'title',
        'costUsd',
        'marginPercent',
        'fixedExpenseBs',
        'commissionPlatform',
        'commissionPaymentMethod',
        'commissionOther',
        'roundStep',
        'rateSourceName',
        'marginMode',
        'rateValue',
        'finalPriceBs',
        'precioExactoBs',
        'gananciaBs',
        'timestamp'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        data.v is int &&
        validStringLength('id', 1, 120) &&
        validStringLength('title', 1, 160) &&
        data.costUsd is number && data.costUsd > 0 &&
        data.marginPercent is number && data.marginPercent >= 0 && data.marginPercent < 100 &&
        data.fixedExpenseBs is number && data.fixedExpenseBs >= 0 &&
        isValidCommission(data.commissionPlatform) &&
        isValidCommission(data.commissionPaymentMethod) &&
        isValidCommission(data.commissionOther) &&
        isValidRoundStep(data.roundStep) &&
        isValidRateSourceName(data.rateSourceName) &&
        isValidOptionalMarginMode('marginMode') &&
        data.rateValue is number && data.rateValue > 0 &&
        data.finalPriceBs is number && data.finalPriceBs > 0 &&
        isValidOptionalNonNegativeNumber('precioExactoBs') &&
        isValidOptionalNumber('gananciaBs') &&
        validStringLength('timestamp', 1, 60);
    }

    // ---------------------------------------------------------------
    // Subscription / Pro settings validators
    // ---------------------------------------------------------------

    function isStr(data, field, minLen, maxLen) {
      return field in data && data[field] is string &&
        data[field].size() >= minLen && data[field].size() <= maxLen;
    }

    function isOptStr(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptNonNegNum(data, field) {
      return !(field in data) || data[field] == null ||
        (data[field] is number && data[field] >= 0);
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') is string &&
         request.auth.token.get('email', '').lower() in [
           'layankrach@gmail.com',
           'soporterefillstore@gmail.com'
         ])
      );
    }

    function isValidActiveSubscription(data) {
      return data.keys().hasAll(['v', 'plan', 'status', 'startDate', 'endDate', 'provider']) &&
        data.keys().hasOnly(['v', 'plan', 'status', 'startDate', 'endDate', 'provider',
          'paymentRef', 'orderId', 'amountUsd', 'paidAmount', 'currency',
          'overpaidAlert', 'durationDays', 'note', 'activatedBy', 'updatedAt']) &&
        data.v is int &&
        data.plan is string && data.plan in ['monthly', 'quarterly', 'semiannual', 'annual'] &&
        data.status is string && data.status in ['active', 'expired', 'canceled'] &&
        isStr(data, 'startDate', 10, 60) &&
        isStr(data, 'endDate', 10, 60) &&
        isStr(data, 'provider', 1, 30) &&
        isOptStr(data, 'paymentRef', 100) &&
        isOptStr(data, 'orderId', 80) &&
        isOptNonNegNum(data, 'amountUsd') &&
        isOptNonNegNum(data, 'paidAmount') &&
        (!('currency' in data) || data.currency == null ||
          (data.currency is string && data.currency in ['BS', 'USD'])) &&
        (!('overpaidAlert' in data) || data.overpaidAlert == null ||
          data.overpaidAlert is bool) &&
        (!('durationDays' in data) || data.durationDays == null ||
          (data.durationDays is int && data.durationDays >= 0 && data.durationDays <= 3650)) &&
        isOptStr(data, 'note', 200) &&
        isOptStr(data, 'activatedBy', 120) &&
        isOptStr(data, 'updatedAt', 60);
    }

    function isValidPendingSubscription(data) {
      return data.keys().hasAll(['v', 'plan', 'method', 'reference', 'amountUsd',
          'status', 'provider', 'requestedAt']) &&
        data.keys().hasOnly(['v', 'plan', 'method', 'reference', 'amountUsd', 'amountBs',
          'rateBs', 'status', 'provider', 'requestedAt']) &&
        data.v is int &&
        data.plan is string && data.plan in ['monthly', 'quarterly', 'semiannual', 'annual'] &&
        data.method is string && data.method in ['pago_movil', 'usdt'] &&
        isStr(data, 'reference', 4, 60) &&
        data.amountUsd is number && data.amountUsd > 0 && data.amountUsd <= 100 &&
        data.status is string && data.status == 'pending' &&
        data.provider is string && data.provider == 'manual' &&
        isStr(data, 'requestedAt', 10, 60) &&
        isOptNonNegNum(data, 'amountBs') &&
        isOptNonNegNum(data, 'rateBs');
    }

    function isValidProfileSettings(data) {
      return data.keys().hasAll(['v', 'businessName', 'updatedAt']) &&
        data.keys().hasOnly(['v', 'businessName', 'updatedAt']) &&
        data.v is int &&
        isStr(data, 'businessName', 0, 60) &&
        isStr(data, 'updatedAt', 10, 60);
    }

    function isValidAlertsSettings(data) {
      return data.keys().hasAll(['v', 'gapEnabled', 'gapThresholdPct', 'rateEnabled', 'updatedAt']) &&
        data.keys().hasOnly(['v', 'gapEnabled', 'gapThresholdPct', 'rateEnabled', 'bcvAboveBs',
          'lastSeenBcvDate', 'lastSeenBcvUsd', 'updatedAt']) &&
        data.v is int &&
        data.gapEnabled is bool &&
        data.gapThresholdPct is number && data.gapThresholdPct >= 0 && data.gapThresholdPct <= 1000 &&
        data.rateEnabled is bool &&
        isOptNonNegNum(data, 'bcvAboveBs') &&
        isOptNonNegNum(data, 'lastSeenBcvUsd') &&
        isOptStr(data, 'lastSeenBcvDate', 20) &&
        isStr(data, 'updatedAt', 10, 60);
    }

    // ===============================================================
    // User-Scoped Data Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /products/{productId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProduct(request.resource.data);
        allow update: if isOwner(userId) &&
          isValidProduct(request.resource.data) &&
          request.resource.data.id == resource.data.id;
      }

      match /history/{historyId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHistoryEntry(request.resource.data);
        allow update: if isOwner(userId) &&
          isValidHistoryEntry(request.resource.data) &&
          request.resource.data.id == resource.data.id;
      }

      match /subscription/{docId} {
        // Active subscription: owner read-only; admin may read, list, write, and delete.
        // Pending payment reference: owner or admin may create/update/delete with strict validation.
        allow get: if (isOwner(userId) && docId in ['current', 'pending']) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if (docId == 'current' && isAdmin() &&
            isValidActiveSubscription(request.resource.data)) ||
          (docId == 'pending' && (isOwner(userId) || isAdmin()) &&
            isValidPendingSubscription(request.resource.data));
        allow delete: if isAdmin() ||
          (docId == 'pending' && isOwner(userId));
      }

      match /settings/{docId} {
        allow get: if isOwner(userId) && docId in ['profile', 'alerts'];
        allow create, update: if isOwner(userId) && (
          (docId == 'profile' && isValidProfileSettings(request.resource.data)) ||
          (docId == 'alerts' && isValidAlertsSettings(request.resource.data)));
        allow delete: if isOwner(userId) && docId in ['profile', 'alerts'];
      }
    }

    // Collection group read/list access for Admin Panel queries (e.g. pending manual payments).
    match /{path=**}/subscription/{docId} {
      allow get, list: if isAdmin();
    }

    // ===============================================================
    // Pabilo Pro Checkout & Server-Only Collections (Admin SDK Only)
    // ===============================================================

    match /proOrders/{orderId} {
      // Non-anonymous owners may read or query their own checkout orders.
      // Clients may never create, update, or delete checkout orders.
      allow get, list: if isNonAnonymous() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /paymentRefs/{refId} {
      // Server-only transactional double-spend lock.
      allow read, write: if false;
    }

    match /rateLimits/{docId} {
      // Server-only rate limiter buckets.
      allow read, write: if false;
    }

    match /config/{docId} {
      // Server-only config (config/proPayments, config/pabiloPrivate);
      // safe fields are exposed via Cloud Function getProPaymentConfig.
      allow read, write: if false;
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
